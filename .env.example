# API base URL (no trailing slash)
VITE_API_URL=http://localhost:3000
# Cloudflare Turnstile site key. 1x00000000000000000000AA is the official always-pass test key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# development | staging | production
VITE_ENV=development
# "mock" starts MSW in the browser (set automatically by `bun run dev:mock`)
VITE_API_MODE=
