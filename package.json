{
  "name": "oauth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "vitest run src/i18n",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:real": "playwright test -c e2e/playwright.real.config.ts",
    "e2e:real:image": "E2E_BACKEND=image playwright test -c e2e/playwright.real.config.ts",
    "e2e:client": "bun e2e/fixtures/test-client/server.ts",
    "screenshots": "SCREENSHOTS=1 playwright test -c e2e/playwright.config.ts --project=screenshots",
    "api:gen": "bun scripts/api-gen.ts",
    "api:check": "bun scripts/api-gen.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
